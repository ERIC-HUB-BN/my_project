[flake8]
max-line-length = 100
# Ignore various persistent formatting/style issues
# E111/E117/E114: 縮排問題 (程式碼 + 註解)
# E261/E262: 註解空格問題
# E301/E302/E303: 空行問題
# E402: import 位置問題
# E501: 行過長問題
# F401: 未使用的 import
# F541: 不必要的 f-string
# W291: 行尾多餘空格
# W292: 檔案結尾缺少空行
ignore = E111, E114, E117, E261, E262, E301, E302, E303, E402, E501, F401, F541, W291, W292