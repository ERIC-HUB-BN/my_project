[flake8]
max-line-length = 100
# 忽略各種持續出現的格式/風格問題，專注功能
ignore =
    # 縮排問題 (Indentation)
    E111, E114, E117, W0311,
    # 空格問題 (Whitespace - comments, operators, brackets)
    E201, E202, E261, E262, W291,
    # 空行/換行問題 (Blank Lines / Newlines)
    E301, E302, E303, W292, C0304,
    # 匯入問題 (Imports)
    E402, F401, W0611, C0411,
    # 行過長 (Line Length)
    E501, C0301,
    # 其他風格建議 (f-string, etc.)
    F541,
    # Pylint Codes (如果 flake8-pylint 插件在跑，或者為了統一)
    W1203, W0718, R1702, R0912

# 可以選擇性地排除某些目錄或檔案 (例如，如果有的話)
# exclude =
#     .git,
#     __pycache__,
#     .venv,
#     venv,
#     build,
#     dist